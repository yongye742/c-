#include <stdio.h>

int isprime(int a);
int main() 
{	
	int n=0;
	scanf("%d",&n);

	for(int x=4;x<=n;x+=2){//遍历4到n的偶数
		for(int p=2;p<x;p++){
			if(isprime(p)&&isprime(x-p)){
				printf("%d=%d+%d\n",x,p,x-p);
				break;
			}
		}
	}
	scanf("%d",&n);

	return 0;
} 
int isprime(int a){//判断是否为质数
	if(a<=1) return 0;
	if(a==2) return 1;
	if(a%2==0) return 0;
	for(int i=3;i*i<=a;i+=2){
		if(a%i==0){
			return 0;
		}
	}
	return 1;

}
